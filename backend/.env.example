# Copia este archivo a `.env` (que está en .gitignore) y ajusta lo que necesites.
# Todas las variables llevan el prefijo PEAKSTROKE_ y son opcionales: los valores
# por defecto de app/core/config.py sirven para desarrollo local.

# --- Entorno ----------------------------------------------------------------
# development | production. En production, config.py exige que auth_enabled,
# jwt_secret y refresh_cookie_secure estén bien puestos o no arranca.
PEAKSTROKE_ENVIRONMENT=development

# --- Base de datos ----------------------------------------------------------
# Por defecto SQLite en backend/peakstroke.db. Para usar el Postgres del
# docker-compose.yml, descomenta la segunda línea (requiere: pip install asyncpg).
# PEAKSTROKE_DATABASE_URL=sqlite+aiosqlite:///./peakstroke.db
# PEAKSTROKE_DATABASE_URL=postgresql+asyncpg://peakstroke:peakstroke@localhost:5432/peakstroke

# --- Identidad --------------------------------------------------------------
# false = la app NO pide login y atribuye todo al usuario de desarrollo.
# Ponlo en true para probar el flujo real de login/roles.
PEAKSTROKE_AUTH_ENABLED=false
PEAKSTROKE_DEV_USER_EMAIL=coach@peakstroke.dev

# --- Tokens -----------------------------------------------------------------
# Genera uno real antes de desplegar:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# PEAKSTROKE_JWT_SECRET=
PEAKSTROKE_ACCESS_TOKEN_MINUTES=15
PEAKSTROKE_REFRESH_TOKEN_DAYS=30
# true en producción (obligatorio): impide que la cookie de refresh viaje por http.
PEAKSTROKE_REFRESH_COOKIE_SECURE=false
